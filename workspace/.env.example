# Zelo Workspace talks only to the local Core HTTP surface.
ZELO_CORE_URL=http://127.0.0.1:8000

# Use the same local operator token as Zelo Core. Never commit the real token.
ZELO_OPERATOR_TOKEN=REPLACE_WITH_YOUR_LOCAL_OPERATOR_TOKEN

# Separate 32-256 character secret for browser access to the local Workspace.
# Never reuse ZELO_OPERATOR_TOKEN or commit the real value.
ZELO_WORKSPACE_ACCESS_TOKEN=REPLACE_WITH_A_DISTINCT_RANDOM_WORKSPACE_SECRET

# Optional local speech adapter. The browser never receives this token.
ZELO_VOICE_URL=http://127.0.0.1:8765
ZELO_VOICE_TOKEN=REPLACE_WITH_A_SEPARATE_LOCAL_VOICE_TOKEN
