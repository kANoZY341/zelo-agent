{"id":"5c5eae20c40a4a26a9915e7ca63ecf50-r03","bank_id":"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public","original_text":"Agent-Reach Web read first calls normalize_public_http_url and requests https://r.jina.ai/ followed by that normalized URL. urlopen receives timeout=30. It calls resp.read(5*1024*1024+1), requesting up to that many bytes, and raises ValueError when the returned body exceeds 5*1024*1024 bytes (5 MiB). The shown timeout argument is not proof of an end-to-end deadline.","content_hash":"6e89e185cf3ed467d4a874032bb59423fee4bdabdb0a15427251a8ac5e0998b1","created_at":"2026-10-10T08:04:06.954610+00:00","updated_at":"2026-10-10T08:04:06.954610+00:00","memory_unit_count":5,"nodes_by_fact_type":{"world":5,"experience":0,"observation":0},"tags":["public","r03"],"document_metadata":{"scope_id":"6de15ab1-e992-49a6-9be8-fe0cf5c0c676","record_id":"r03","scope_key":"public","source_id":"web","created_at":"2026-10-01T00:00:00Z","expires_at":"","scope_kind":"project","document_id":"5c5eae20c40a4a26a9915e7ca63ecf50-r03","record_sha256":"da0d59ea97cefd5730f440de0882036e9a5ccaec48ef64e86d1da1acfbaf7f11","report_sha256":"d10585450dc9f48137e107bd35446198536b4c94fe309f3b5a359df03114d3b1","core_memory_id":"25d01906-5307-4bb6-9416-36bdeba43f17","receipt_sha256":"73ba4de90cae13005579526f7c09a6710f3ae04d7d4f9d285f48cdb9b734ed7e","comparison_run_id":"5c5eae20c40a4a26a9915e7ca63ecf50","replaces_record_id":"","core_provenance_kind":"import","replaces_core_memory_id":""},"retain_params":{"metadata":{"scope_id":"6de15ab1-e992-49a6-9be8-fe0cf5c0c676","record_id":"r03","scope_key":"public","source_id":"web","created_at":"2026-10-01T00:00:00Z","expires_at":"","scope_kind":"project","document_id":"5c5eae20c40a4a26a9915e7ca63ecf50-r03","record_sha256":"da0d59ea97cefd5730f440de0882036e9a5ccaec48ef64e86d1da1acfbaf7f11","report_sha256":"d10585450dc9f48137e107bd35446198536b4c94fe309f3b5a359df03114d3b1","core_memory_id":"25d01906-5307-4bb6-9416-36bdeba43f17","receipt_sha256":"73ba4de90cae1300