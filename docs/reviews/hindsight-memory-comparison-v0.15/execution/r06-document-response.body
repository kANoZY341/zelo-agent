{"id":"5c5eae20c40a4a26a9915e7ca63ecf50-r06","bank_id":"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public","original_text":"After a successful yt-dlp probe, Agent-Reach YouTube readiness checks for Deno or Node. In the Node-present, Deno-absent branch, _has_js_runtime_config calls read_small_text_no_follow with max_bytes=1024*1024 and checks the returned text for the literal substring --js-runtimes. It does not parse or validate the flag's effective value; the reading helper was not inspected. Missing that substring leads to a warn branch.","content_hash":"7587dab3b43a095033a977a779c7ffcd454874fdc8b7d9dd3c2131f9d3b8ccd5","created_at":"2026-10-10T08:08:14.982064+00:00","updated_at":"2026-10-10T08:08:14.982064+00:00","memory_unit_count":4,"nodes_by_fact_type":{"world":0,"experience":4,"observation":0},"tags":["public","r06"],"document_metadata":{"scope_id":"6de15ab1-e992-49a6-9be8-fe0cf5c0c676","record_id":"r06","scope_key":"public","source_id":"youtube","created_at":"2026-10-01T00:00:00Z","expires_at":"","scope_kind":"project","document_id":"5c5eae20c40a4a26a9915e7ca63ecf50-r06","record_sha256":"294f6c027518215799ecc59752f8fa988b5189b7694f8638e1fe81e3f359eadd","report_sha256":"d10585450dc9f48137e107bd35446198536b4c94fe309f3b5a359df03114d3b1","core_memory_id":"54d2013a-6009-4300-b2b9-5013245d9c27","receipt_sha256":"73ba4de90cae13005579526f7c09a6710f3ae04d7d4f9d285f48cdb9b734ed7e","comparison_run_id":"5c5eae20c40a4a26a9915e7ca63ecf50","replaces_record_id":"","core_provenance_kind":"import","replaces_core_memory_id":""},"retain_params":{"metadata":{"scope_id":"6de15ab1-e992-49a6-9be8-fe0cf5c0c676","record_id":"r06","scope_key":"public","source_id":"youtube","created_at":"2026-10-01T00:00:00Z","expires_at":"","scope_kind":"project","document_id":"5c5eae20c40a4a26a9915e7ca63ecf50-r06","record_sha256":"294f6c027518215799ecc59752f8fa988b5189b7694f8638e1fe81e3f359eadd","report_sha256":"d10585450dc9f48137e107bd35446198536b4c94fe309f3b5a359df03114d3b1","core_memory_id":"54d2013a-60