ed":0.00001282446646655444,"rrf_normalized":0.0,"temporal":0.5,"recency":0.9753424667047185,"proof_norm":0.5,"combined_score":0.000014043669171431226,"weight":0.000014043669171431226,"activation":0.000014043669171431226},{"id":"646832c2-e621-405a-abce-547b3c29f940","text":"Agent-Reach Web check selected Jina Reader, returned status ok without network request, which did not confirm actual retrieval of Jina Reader or target pages. | When: 2026-10-01","fact_type":"experience","context":"","event_date":"2026-10-01T00:00:00Z","occurred_start":null,"occurred_end":null,"mentioned_at":"2026-10-01T00:00:00+00:00","document_id":"5c5eae20c40a4a26a9915e7ca63ecf50-r04","chunk_id":"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r04_0","tags":["public","r04"],"metadata":"{\"scope_id\": \"6de15ab1-e992-49a6-9be8-fe0cf5c0c676\", \"record_id\": \"r04\", \"scope_key\": \"public\", \"source_id\": \"web\", \"created_at\": \"2026-10-01T00:00:00Z\", \"expires_at\": \"\", \"scope_kind\": \"project\", \"document_id\": \"5c5eae20c40a4a26a9915e7ca63ecf50-r04\", \"record_sha256\": \"b552e31ae1bf32b6e219a141bbe5a30e294c338f152856193ca45100c2ab6e28\", \"report_sha256\": \"d10585450dc9f48137e107bd35446198536b4c94fe309f3b5a359df03114d3b1\", \"core_memory_id\": \"21792005-b38b-4eff-b248-733eca13bd1b\", \"receipt_sha256\": \"73ba4de90cae13005579526f7c09a6710f3ae04d7d4f9d285f48cdb9b734ed7e\", \"comparison_run_id\": \"5c5eae20c40a4a26a9915e7ca63ecf50\", \"replaces_record_id\": \"\", \"core_provenance_kind\": \"import\", \"replaces_core_memory_id\": \"\"}","attachment_ids":null,"semantic_similarity":0.8111041188240051,"bm25_score":null,"rrf_score":0.029437229437229435,"rrf_rank":8,"semantic_rank":10,"bm25_rank":6,"cross_encoder_score":0.000012700007573585026,"cross_encoder_score_normalized":0.000012700007573585026,"rrf_normalized":0.0,"temporal":0.5,"recency":0.9753424657534246,"proof_norm":0.5,"combined_score":0.00001390737815660804,"weight":0.00001390737815660804,"activation":0.00001390737815660804}]},"entities":null,"chunks":{"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r06_0":{"id":"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r06_0","text":"After a successful yt-dlp probe, Agent-Reach YouTube readiness checks for Deno or Node. In the Node-present, Deno-absent branch, _has_js_runtime_config calls read_small_text_no_follow with max_bytes=1024*1024 and checks the returned text for the literal substring --js-runtimes. It does not parse or validate the flag's effective value; the reading helper was not inspected. Missing that substring leads to a warn branch.","chunk_index":0,"truncated":false,"attachments":null},"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r05_0":{"id":"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r05_0","text":"Agent-Reach YouTube readiness invokes probe_command for yt-dlp with [--version], timeout=10 and package=yt-dlp. A missing probe status yields off; broken or another non-ok probe yields error. It does not download a video in this check.","chunk_index":0,"truncated":false,"attachments":null},"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r07_0":{"id":"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r07_0","text":"Agent-Reach YouTube transcribe defaults provider to auto and allow_provider_fallback to False and passes both to the lazily imported agent_reach.transcribe.transcribe helper. That helper's implementation was not inspected, so its actual transcription and fallback behavior remain unknown.","chunk_index":0,"truncated":false,"attachments":null},"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r01_0":{"id":"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r01_0","text":"Agent-Reach RSS readiness imports feedparser. ImportError yields off; another import-time exception yields error; a successful import yields ok and selects feedparser. This check does not fetch a feed.","chunk_index":0,"truncated":false,"attachments":null},"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r03_0":{"id":"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r03_0","text":"Agent-Reach Web read first calls normalize_public_http_url and requests https://r.jina.ai/ followed by that normalized URL. urlopen receives timeout=30. It calls resp.read(5*1024*1024+1), requesting up to that many bytes, and raises ValueError when the returned body exceeds 5*1024*1024 bytes (5 MiB). The shown timeout argument is not proof of an end-to-end deadline.","chunk_index":0,"truncated":false,"attachments":null},"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r02_0":{"id":"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r02_0","text":"Agent-Reach RSS can_handle lowercases the URL and tests whether any of the substrings /feed, /rss, .xml or atom occurs in it. This is URL substring matching, not parsing or fetching RSS/Atom content.","chunk_index":0,"truncated":false,"attachments":null},"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r04_0":{"id":"zelo-5c5eae20c40a4a26a9915e7ca63ecf50-public_5c5eae20c40a4a26a9915e7ca63ecf50-r04_0","text":"Agent-Reach Web check selects Jina Reader and returns the literal status ok without a network request. This readiness result does not prove that Jina Reader or any target page was retrieved.","chunk_index":0,"truncated":false,"attachments":null}},"source_facts":null,"source_facts_truncated":null}