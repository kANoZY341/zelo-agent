# Preserve pinned REA source and manifest bytes through Windows-style checkouts.
# Upstream REA files retain their trailing whitespace; local Zelo source does not.
third_party/rea/** -text -whitespace
integrations/rea/source-v6.0.0.manifest.json -text

# The curated verifier pins exact manifest and upstream source bytes. Git must
# not rewrite their line endings in Windows-style checkouts.
integrations/community/sources.json -text
integrations/community/sources/** -text
