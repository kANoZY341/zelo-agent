# Local-only configuration for Zelo Agent v0.11 and post-v0.11 increments.
ZELO_APP_NAME="Zelo Agent"
# v0.13 storage abstraction is explicit and fail-closed; SQLite is the only enabled backend.
# ZELO_STORAGE_BACKEND=sqlite
# Keep Ollama bound to localhost; cloud and arbitrary provider URLs are unsupported.
ZELO_OLLAMA_URL="http://127.0.0.1:11434"
ZELO_OLLAMA_GENERAL_MODEL="qwen3:4b-instruct"
# Optional: give Zelo Mind its own conversational model. If omitted, Mind uses GENERAL_MODEL.
# Example upgrade: qwen3.5:4b
ZELO_OLLAMA_MIND_MODEL="qwen3:4b-instruct"
ZELO_OLLAMA_REASONING_MODEL="deepseek-r1:7b"
ZELO_MODEL_CONFIG_VERSION="1"
# Workspace tools are confined to this repository directory by default.
# ZELO_WORKSPACE_MAX_ENTRIES=1000
# ZELO_WORKSPACE_MAX_DEPTH=8
# ZELO_WORKSPACE_MAX_FILE_SIZE=1048576
# Named read-only HTTPS API endpoints; empty by default. Canonical origins only.
# ZELO_API_WORKER_ENDPOINTS='["example=https://api.example.com"]'
# Browser document rendering is a separate, DEFAULT DISABLED operator-only lane.
ZELO_BROWSER_WORKER_ENABLED=false
# All five settings below are required before explicitly enabling after release/host gates.
# Endpoint registry must exactly match the offline preparation receipt.
# ZELO_BROWSER_WORKER_ENDPOINTS='["docs=https://docs.example.com"]'
# ZELO_BROWSER_WORKER_RECEIPT=/absolute/private/browser-prepared/verified-receipt.json
# ZELO_BROWSER_WORKER_BUNDLE=/absolute/private/browser-prepared/build/bundle
# ZELO_BROWSER_WORKER_RUNTIME=/absolute/private/browser-prepared/runtime
# One canonical persistent 0700 admission directory for ALL jobs/processes; never per request.
# ZELO_BROWSER_WORKER_ADMISSION=/absolute/private/browser-prepared/admission
# Optional persistent per-agent computer infrastructure (v0.15 foundation).
# This does not itself grant any Agent browser/file/shell authority.
# Start the exact pinned backend with compose.agent-computers.yml.
# ZELO_COMPUTER_SUPERVISOR_URL=http://127.0.0.1:4312
# ZELO_COMPUTER_SUPERVISOR_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_24_CHARS
# ZELO_COMPUTER_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_24_CHARS
# Optional independent Coding review format, captured in approvals:
# ZELO_DEVELOPER_REVIEW_FORMAT=open_code_review
# Default is zelo; no extra reviewer, network, publication or grant is enabled.
# ZELO_COMPUTER_NAMESPACE=zelo
# Optional exact-registry Computer Specialist; inspect with:
# python -m scripts.preview_computer_observer
# The owner must review the emitted registry digest before setting it.
# This does not create an AgentInstance, grant access or start a computer.
# ZELO_COMPUTER_OBSERVER_APPROVED_REGISTRY_SHA256=REPLACE_WITH_REVIEWED_64_CHAR_REGISTRY_SHA256
# ZELO_COMPUTER_REQUEST_TIMEOUT_SECONDS=70
# Browser-mutation egress remains disabled unless a trusted endpoint grant exists.
# The proxy binds to the internal Docker network gateway; the subnet/gateway are
# shared with compose.agent-computers.yml and may be changed together.
# ZELO_COMPUTER_INTERNAL_NETWORK_CIDR=172.30.250.0/24
# ZELO_COMPUTER_NETWORK_NAME=zelo-agent-computer-sandbox
# ZELO_COMPUTER_EGRESS_PROXY_HOST=172.30.250.1
# ZELO_COMPUTER_EGRESS_PROXY_PORT=4390
# Trusted HTTPS origins eligible for a future Agent computer egress proxy.
# Declaring these does NOT enable navigation by itself.
# ZELO_COMPUTER_BROWSER_ENDPOINTS='["docs=https://docs.example.com"]'
# Supervisor deployment-only knobs used by compose.agent-computers.yml:
# ZELO_COMPUTER_MEMORY_BYTES=2147483648
# ZELO_COMPUTER_RUNTIME=runsc

# Bounded agent runs use only the general model and existing policy-allowed tools.
ZELO_MAX_AGENT_STEPS=6
ZELO_MAX_AGENT_TOOL_CALLS=4
ZELO_AGENT_TIMEOUT_SECONDS=120
ZELO_MAX_MODEL_PARSE_RETRIES=1
ZELO_MODEL_TIMEOUT_SECONDS=60
# Early Talk-to-Zelo uses process-wide model admission independent of conversation IDs.
ZELO_MIND_MAX_CONCURRENCY=1
ZELO_MIND_ADMISSION_TIMEOUT_SECONDS=1.0
# Maximum serialized tool-result characters returned per call (envelope excluded).
ZELO_MAX_AGENT_TOOL_RESULT_CHARS=8192
# Developer workers use fixed Zelo-owned commands and limits.
# ZELO_DEVELOPER_TIMEOUT_SECONDS=900
# ZELO_DEVELOPER_VALIDATION_TIMEOUT_SECONDS=600
# ZELO_DEVELOPER_WORKER_TIMEOUT_SECONDS=600
# ZELO_DEVELOPER_GIT_TIMEOUT_SECONDS=15
# ZELO_DEVELOPER_STDOUT_BYTES=262144
# ZELO_DEVELOPER_STDERR_BYTES=16384
# ZELO_DEVELOPER_JSONL_LINE_BYTES=16384
# ZELO_DEVELOPER_JSONL_EVENTS=1024
# ZELO_DEVELOPER_DIFF_BYTES=32768
# ZELO_DEVELOPER_CHANGED_FILES=200
# Trusted operator configuration only; never accepted in task input.
# ZELO_DEVELOPER_CODEX_EXECUTABLE=/absolute/path/to/codex
# ZELO_DEVELOPER_CODEX_AUTH_FILE=/absolute/path/to/cli-managed/auth.json
# Optional v0.10 workers remain disabled unless explicitly enabled by trusted operator config.
# ZELO_DEVELOPER_CLAUDE_ENABLED=false
# ZELO_DEVELOPER_CLAUDE_EXECUTABLE=/absolute/path/to/claude
# ZELO_DEVELOPER_CLAUDE_OAUTH_TOKEN_FILE=/absolute/path/to/zelo-oauth-token
# ZELO_DEVELOPER_CLAUDE_MODEL=claude-sonnet-5
# ZELO_DEVELOPER_OPENCODE_ENABLED=false
# ZELO_DEVELOPER_OPENCODE_EXECUTABLE=/absolute/path/to/opencode
# OpenCode's local Ollama lane needs a model runtime context larger than its framework prompt;
# use at least 8k context (16k recommended) and configure that exact Ollama model/alias here.
# Example: ZELO_DEVELOPER_OPENCODE_MODEL=ollama/qwen2.5-coder:3b-instruct-8k

# v0.7 promotion is restricted to this configured repository; task input cannot override it.
# ZELO_PROMOTION_REPOSITORY="kANoZY341/zelo-agent"
# ZELO_PROMOTION_GIT_AUTHOR_NAME="Zelo Agent"
# ZELO_PROMOTION_GIT_AUTHOR_EMAIL="zelo@localhost.invalid"
# Trusted GitHub CLI credentials stay in the operator-owned gh config; workers never see them.
# ZELO_PROMOTION_GH_EXECUTABLE=/usr/bin/gh
# ZELO_PROMOTION_GH_CONFIG_DIR=/home/zelo/.config/gh
# ZELO_PROMOTION_GITHUB_TIMEOUT_SECONDS=30
# JSON list of exact GitHub check-run names required before merge approval.
# ZELO_PROMOTION_REQUIRED_CHECKS='["checks"]'
# Bind required check-runs to the trusted GitHub App, not just a spoofable check name.
# ZELO_PROMOTION_CI_APP_ID=15368
# ZELO_PROMOTION_CI_APP_SLUG="github-actions"

# Optional v0.12 local push-to-talk speech adapter.
# Keep a separate random token from ZELO_OPERATOR_TOKEN.
# ZELO_VOICE_TOKEN=REPLACE_WITH_A_SEPARATE_LOCAL_VOICE_TOKEN
# ZELO_VOICE_PORT=8765
# ZELO_STT_MODEL=small
# ZELO_STT_DEVICE=cpu
# ZELO_STT_COMPUTE_TYPE=int8
# ZELO_TTS_PROVIDER=chatterbox
# ZELO_TTS_DEVICE=cpu
# Keep below the Workspace voice proxy timeout (120s by default).
# ZELO_TTS_DEADLINE_SECONDS=110
# Optional operator-owned reference clip for changing Zelo's voice later.
# ZELO_TTS_REFERENCE_AUDIO=/absolute/path/to/reference.wav
# Fast CPU fallback: ZELO_TTS_PROVIDER=sherpa_vits
# Point each language at a converted Piper/VITS bundle containing exactly one
# .onnx model plus tokens.txt and espeak-ng-data/.
# ZELO_SHERPA_EN_MODEL_DIR=/absolute/path/to/vits-piper-en_US-lessac-medium
# ZELO_SHERPA_AR_MODEL_DIR=/absolute/path/to/vits-piper-ar_JO-kareem-medium
# ZELO_SHERPA_TTS_DEVICE=cpu
# ZELO_SHERPA_TTS_THREADS=4
# ZELO_SHERPA_TTS_SPEED=1.0

# Qualified Shell built-in compute is disabled by default; no model/Mind route.
ZELO_SHELL_WORKER_ENABLED=false
# Explicit operator enablement needs a canonical existing nonroot-owned 0700 directory.
# ZELO_SHELL_WORKER_ADMISSION=/absolute/private/persistent-shell-admission

# Optional operator-only inert learned-skill candidate staging directory.
# Must be an absolute path inside ZELO_RUNTIME_DIR.
# ZELO_SKILL_LEARNING_CANDIDATE_ROOT=/absolute/path/to/repo/runtime/skill-learning-candidates
