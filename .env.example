# Local-only configuration for Zelo Agent v0.6.
ZELO_APP_NAME="Zelo Agent"
# Keep Ollama bound to localhost; cloud and arbitrary provider URLs are unsupported.
ZELO_OLLAMA_URL="http://127.0.0.1:11434"
ZELO_OLLAMA_GENERAL_MODEL="qwen3:4b-instruct"
ZELO_OLLAMA_REASONING_MODEL="deepseek-r1:7b"
ZELO_MODEL_CONFIG_VERSION="1"
# Workspace tools are confined to this repository directory by default.
# ZELO_WORKSPACE_MAX_ENTRIES=1000
# ZELO_WORKSPACE_MAX_DEPTH=8
# ZELO_WORKSPACE_MAX_FILE_SIZE=1048576
# Bounded agent runs use only the general model and existing policy-allowed tools.
ZELO_MAX_AGENT_STEPS=6
ZELO_MAX_AGENT_TOOL_CALLS=4
ZELO_AGENT_TIMEOUT_SECONDS=120
ZELO_MAX_MODEL_PARSE_RETRIES=1
ZELO_MODEL_TIMEOUT_SECONDS=60
# Maximum serialized tool-result characters returned per call (envelope excluded).
ZELO_MAX_AGENT_TOOL_RESULT_CHARS=8192
# Developer workers use fixed Zelo-owned commands and limits.
# ZELO_DEVELOPER_TIMEOUT_SECONDS=900
# ZELO_DEVELOPER_VALIDATION_TIMEOUT_SECONDS=600
# ZELO_DEVELOPER_WORKER_TIMEOUT_SECONDS=600
# ZELO_DEVELOPER_GIT_TIMEOUT_SECONDS=15
# ZELO_DEVELOPER_STDOUT_BYTES=262144
# ZELO_DEVELOPER_STDERR_BYTES=16384
# ZELO_DEVELOPER_JSONL_LINE_BYTES=16384
# ZELO_DEVELOPER_JSONL_EVENTS=1024
# ZELO_DEVELOPER_DIFF_BYTES=32768
# ZELO_DEVELOPER_CHANGED_FILES=200
# Trusted operator configuration only; never accepted in task input.
# ZELO_DEVELOPER_CODEX_EXECUTABLE=/absolute/path/to/codex
# ZELO_DEVELOPER_CODEX_AUTH_FILE=/absolute/path/to/cli-managed/auth.json

# v0.7 promotion is restricted to this configured repository; task input cannot override it.
# ZELO_PROMOTION_REPOSITORY="kANoZY341/zelo-agent"
